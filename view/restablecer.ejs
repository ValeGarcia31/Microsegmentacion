<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8">
        <meta name="referrer" content="no-referrer">
        <title>Restablecer contraseña | Seguridad Informática 1 - PanFreddy Hackers</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="Restablecer contraseña - Seguridad Informática 1" name="description">
        <link href="/assets/css/sweetalert2.min.css" rel="stylesheet" type="text/css">
        <link rel="stylesheet" href="/assets/css/preloader.min.css" type="text/css">
        <link href="/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css">
        <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
        <link href="/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="/assets/css/auth-modern.css" rel="stylesheet" type="text/css">
    </head>
    <body class="sa-auth">
        <main class="sa-wrap">
            <div class="sa-binary-rain" aria-hidden="true">
                <span>010110101001101011010010110100101101001011010</span>
                <span>101001011010110100101101001011010010110101101</span>
                <span>011010010110101101001011010110100101101001011</span>
                <span>110100101101001011010110100101101011010010110</span>
                <span>001011010110100101101011010010110100101101001</span>
                <span>101101001011010110100101101001011010110100101</span>
                <span>010110100101101011010010110101101001011010</span>
            </div>
            <header class="sa-brand">
                <div class="sa-brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img">
                        <path d="M12 3 19 6v5c0 4.7-2.8 8.2-7 10-4.2-1.8-7-5.3-7-10V6l7-3Z"></path>
                        <rect x="8.5" y="10.5" width="7" height="5.5" rx="1"></rect>
                        <path d="M10 10.5V9a2 2 0 0 1 4 0v1.5"></path>
                    </svg>
                </div>
                <h1>Seguridad Informática 1</h1>
                <p>PanFreddy Hackers</p>
            </header>
            <section class="sa-card">
                <div class="sa-card-head">
                    <div class="sa-icon-circle"><i class="mdi mdi-key-variant"></i></div>
                    <h2>Restablecer contraseña</h2>
                    <% if (!recuperacionValida) { %>
                        <p>El enlace no es válido o ya venció. Solicita uno nuevo.</p>
                        <a href="../recuperar/" class="btn btn-primary w-100 mt-4">Solicitar otro enlace</a>
                    <% } else { %>
                        <p>Ingresa tu nueva contraseña.</p>
                    <% } %>
                </div>
                <% if (recuperacionValida) { %>
                    <form id="restablecer_form" class="custom-form">
                        <input type="hidden" name="token" value="<%= token %>">
                        <div class="mb-3">
                            <label for="usu_pass" class="form-label">Nueva contraseña</label>
                            <input type="password" class="form-control" id="usu_pass" name="usu_pass" required>
                        </div>
                        <div class="mb-4">
                            <label for="usu_pass_confir" class="form-label">Confirmar contraseña</label>
                            <input type="password" class="form-control" id="usu_pass_confir" name="usu_pass_confir" required>
                        </div>
                        <button class="btn btn-primary w-100 waves-effect waves-light" type="submit">
                            Restablecer contraseña
                        </button>
                    </form>
                <% } %>
                <div class="sa-divider"></div>
                <p class="sa-foot-link">Regresar a <a href="/login" class="sa-link">Acceder</a></p>
            </section>
            <p class="sa-copy">© <script>document.write(new Date().getFullYear())</script> Seguridad Informática 1 · PanFreddy Hackers</p>
        </main>
        <script src="/assets/js/jquery.min.js"></script>
        <script src="/assets/js/bootstrap.bundle.min.js"></script>
        <script src="/assets/js/sweetalert2.min.js"></script>
        <% if (recuperacionValida) { %>
            <script src="/view/restablecer/restablecer.js"></script>
        <% } %>
    </body>
</html>
