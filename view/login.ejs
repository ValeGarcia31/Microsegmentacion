                <span>110100101101001011010110100101101011010010110</span>
                <span>001011010110100101101011010010110100101101001</span>
                <span>101101001011010110100101101001011010110100101</span>
                <span>010110100101101011010010110101101001011010</span>
                <span>110010110100101101011010010110100101101001</span>
                <span>001101101001011010110100101101001011010110</span>
                <span>101011010010110100101101011010010110100101</span>
                <span>011010110100101101001011010110100101101011</span>
                <span>110101001011010110100101101001011010010110</span>
                <span>010110100101101011010010110100101101001011</span>
                <span>101101001011010110100101101011010010110100</span>
                <span>011010010110101101001011010110100101101001</span>
                <span>110100101101011010010110100101101001011</span>
                <span>001011010110100101101011010010110101</span>
                <span>101101001011010110100101101011010010</span>
                <span>010110100101101011010010110100101101</span>
                <span>110010110100101101001011010110100101</span>
                <span>001101101001011010110100101101001011</span>
                <span>101011010010110100101101011010010110</span>
                <span>011010110100101101001011010110100101</span>
                <span>110101001011010110100101101001011010</span>
                <span>010110100101101011010010110100101101</span>
                <span>101101001011010110100101101011010010</span>
                <span>011010010110101101001011010110100101</span>
            </div>
            <div class="sa-ubuntu-watermark" aria-hidden="true">
                <svg viewBox="0 0 120 120">
                    <circle class="sa-ubuntu-ring" cx="60" cy="60" r="31"></circle>
                    <circle class="sa-ubuntu-dot" cx="60" cy="21" r="9"></circle>
                    <circle class="sa-ubuntu-dot" cx="26" cy="80" r="9"></circle>
                    <circle class="sa-ubuntu-dot" cx="94" cy="80" r="9"></circle>
                </svg>
            </div>
            <header class="sa-brand">
                <div class="sa-brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img">
                        <path d="M12 3 19 6v5c0 4.7-2.8 8.2-7 10-4.2-1.8-7-5.3-7-10V6l7-3Z"></path>
                        <rect x="8.5" y="10.5" width="7" height="5.5" rx="1"></rect>
                        <path d="M10 10.5V9a2 2 0 0 1 4 0v1.5"></path>
                    </svg>
                </div>
                <h1>Seguridad Informática 1</h1>
                <p>PanFreddy Hackers</p>
            </header>
            <section class="sa-card">
                <div class="sa-card-head">
                    <h2>Iniciar sesión</h2>
                    <p>Ingrese sus credenciales.</p>
                </div>
                <form class="custom-form" action="" method="post">

                    <% if (message === "1") { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-block-helper me-2"></i>
                            Credenciales incorrectas.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } else if (message === "2") { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-block-helper me-2"></i>
                            Campos Vacios.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } else if (message === "3") { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-block-helper me-2"></i>
                            Contraseña Incorrecta.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } else if (message === "4") { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-block-helper me-2"></i>
                            Tu cuenta aún no está confirmada. Revisa tu correo.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } else if (message === "5") { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-check-circle me-2"></i>
                            Contraseña actualizada. Ya puedes iniciar sesión.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <div class="mb-3">
                        <label class="form-label" for="usu_correo">Correo Electronico</label>
                        <input type="email" class="form-control" id="usu_correo" name="usu_correo" placeholder="Ingrese Correo Electronico" required>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <label class="form-label" for="usu_pass">Contraseña</label>
                            <a href="/recuperar" class="sa-link small mb-2">¿Olvidaste tu contraseña?</a>
                        </div>
                        <div class="input-group auth-pass-inputgroup">
                            <input type="password" class="form-control" id="usu_pass" name="usu_pass" placeholder="Ingrese Contraseña" aria-label="Password" aria-describedby="password-addon" required>
                            <button class="btn btn-light shadow-none ms-0" type="button" id="password-addon" aria-label="Mostrar contraseña" aria-pressed="false">
                                <svg class="sa-password-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                                    <circle cx="12" cy="12" r="2.5"></circle>
                                    <path class="sa-eye-slash" d="m4 4 16 16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember-check">
                            <label class="form-check-label" for="remember-check">Recuerdame</label>
                        </div>
                    </div>
                    <div>
                        <input type="hidden" name="enviar" value="si">
                        <button class="btn btn-primary w-100 waves-effect waves-light" type="submit">Acceder</button>
                    </div>
                </form>

                <div class="sa-divider"></div>
                <p class="sa-foot-link">¿No tienes cuenta? <a href="/register" class="sa-link">Regístrate</a></p>
            </section>
            <p class="sa-copy">© <script>document.write(new Date().getFullYear())</script> Seguridad Informática 1 · PanFreddy Hackers</p>
        </main>

